[node name="text" parent="." unique_id=1734454769 instance=ExtResource("1_uc2hm")]
position = Vector2(572, 546)
dialog_array = ["mumble..mumble...GAH! It's a walking neon sign. How are you still alive? Dumb luck probably...", "Oh you want to go to the city! Snort..well isn't that a nice dream. Listen kid your better off just forgetting it. ", "The city is not how it seems. It's filthy, dangerous, and you can't even breath there. You don't WANT to go there. I almost died! Almost got EATEN!", "And why would I want to be responsible for your death Neon Sign??", "Please? You think begging is going to cut it? Absolutely not. Shoo..", "Stop begging it's getting old you're like a child...", "...", "FINE! I'll help your tail die quicker if that's what you want. Your life not mine!", "BUT ...one one condition", "I want you to do a favor for me. The current took away my wife, she's stuck in a rouge area somewhere east and I've heard it's INFESTED with sharks. Now, obviously I'd have gone myself -  except I don't quite have those fast flippers like you Neon Sign.", "So if you can survive those shark waters, then perhaps, just MAYBE you wouldn't die out there in the city. So are you intrested?"]
fish_name = "          bobu the crab fish"
fish_sprite = ExtResource("1_n75bl")

[node name="text" parent="." unique_id=1734454769 groups=["minigame"] instance=ExtResource("1_4iyo7")]
position = Vector2(572, 546)
dialog_array = ["AHHHHH!!!", "Oh my god I thought you were going to eat me! But you're just a little fish! Are you here to save me from these sharks or are you lost too?", "Awwwww Bobu sent you to save me? That jerk was too jellyfish to save me himself? I bet he gave you some stupid excuse like it's toooo farRrRr or he doesn't have finnns..", "Ugh! You poor thing! I will yell at him when we get home! And thanks little fish for coming all the way out here to save me - that's really brave", "Now I'm hoping you have a plan to get out of here because there are tons of sharks!", "WHAT? you beat up all the sharks too? That's something there for sure kid. Have you considered joining my fight club? I think you'd do really well", "You're in a rush? Awwww... maybe next time though? My fight club is always open for strong fish like you!", "Now I hate to break it to you but I think you missed two over there. ", "We're going to have to sneak out..."]
fish_name = "Kailani the Crab"
fish_sprite = ExtResource("1_tyy7c")
